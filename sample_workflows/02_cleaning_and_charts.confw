   "id": 3,
   "name": "Gen",
   "x": 400,
   "y": 120,
   "settings": {
    "lines": [
     "log_wage = log(wage)",
     "wage_growth = growth(wage, by=region) * 100",
     "real_wage_growth = wage_growth - inflation",
     "house_to_wage = house_price_k * 1000 / (wage * 52)",
     "high_unemployment = unemployment >= 8"
    ]
   }
  },
  {
   "id": 4,
   "name": "Filter",
   "x": 600,
   "y": 120,
   "settings": {
